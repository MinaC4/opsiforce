{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["file:///opt/opencode/plugins/image-normalize.ts"],
  "default_agent": "app-builder",
  "agent": {
    "build": {
      "disable": true
    }
  },
  "disabled_providers": ["opencode"],
  "provider": {
    "anthropic": {
      "whitelist": ["claude-opus-5", "claude-sonnet-5", "claude-haiku-4-5"],
      "models": {
        "claude-opus-5": {
          "options": {
            "reasoningEffort": "high"
          }
        },
        "claude-sonnet-5": {
          "options": {
            "reasoningEffort": "high"
          }
        },
        "claude-haiku-4-5": {}
      }
    },
    "openai": {
      "whitelist": ["gpt-5.6-sol", "gpt-5.6-sol-fast"],
      "models": {
        "gpt-5.6-sol": {
          "limit": { "context": 290400, "output": 32000 },
          "options": {
            "reasoningEffort": "high"
          },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "xhigh": { "reasoningEffort": "xhigh" }
          }
        },
        "gpt-5.6-sol-fast": {
          "limit": { "context": 290400, "output": 32000 },
          "options": {
            "reasoningEffort": "high"
          },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "xhigh": { "reasoningEffort": "xhigh" }
          }
        }
      }
    }
  },
  "model": "openai/gpt-5.6-sol",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "mcp": "allow",
    "external_directory": "allow",
    "websearch": "allow",
    "question": "allow",
    "skill": "allow"
  }
}
